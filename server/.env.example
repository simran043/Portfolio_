# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Long random string used to sign in to /admin. Leave empty to disable the admin API.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Comma-separated origins allowed to call the API directly (the Vite dev server uses a proxy).
CORS_ORIGINS=http://localhost:5173

# Set to true when running behind a reverse proxy (Render, Railway, Nginx...) so rate limits see real IPs.
TRUST_PROXY=false

# Time zone used to group visits by day.
ANALYTICS_TIMEZONE=Asia/Kolkata

# Optional: send contact-form messages by email (Nodemailer). Messages are always saved to MongoDB.
# For Gmail, use an App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=
